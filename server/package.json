{
  "name": "gift-shop-server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --transpile-only --ignore-watch node_modules --no-notify src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed:gifts": "ts-node --transpile-only src/scripts/seedGifts.ts",
    "seed:leaderboard": "ts-node --transpile-only src/scripts/seedLeaderboard.ts",
    "seed:orders": "ts-node --transpile-only src/scripts/seedOrders.ts",
    "seed:all": "ts-node --transpile-only src/scripts/seedAll.ts"
  },
  "dependencies": {
    "@tma.js/init-data-node": "^2.0.1",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "crypto-bot-api": "^0.3.3",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "grammy": "^1.38.2",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "mongoose": "^8.18.2",
    "socket.io": "^4.8.1",
    "vue-i18n": "^10.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "_moduleAliases": {
    "@": "dist"
  }
}
